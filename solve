#!/usr/bin/env sh

exec python3 -c '
import argparse, collections, os, sys, json, re, urllib.request

parser = argparse.ArgumentParser(description="Scrabble CLI Solver Table")
parser.add_argument("rack", help="Letters in rack (? or . for blanks)")
parser.add_argument("-s", "--starts", default="", help="Word must start with these letters")
parser.add_argument("-e", "--ends", default="", help="Word must end with these letters")
parser.add_argument("-m", "--middle", default="", help="Board letter that must appear inside the word (not first/last)")
parser.add_argument("-a", "--anchor", default="", help="Board anchor letters anywhere in word")
parser.add_argument("-l", "--len", "--length", default="", help="Filter length: single integer (2), range (2-5), or minimum (4+)")

args = parser.parse_args()

# ANSI Colors
C_RESET  = "\033[0m"
C_SCORE  = "\033[1;33m"  # Bold Yellow
C_WORD   = "\033[1;36m"  # Cyan
C_TOP    = "\033[1;32m"  # Green for top score
C_MATCH  = "\033[1;32m"  # Green
C_BINGO  = "\033[1;35m"  # Magenta
C_DEF    = "\033[3;90m"  # Italic Gray
C_DIM    = "\033[90m"    # Muted Gray
C_BORDER = "\033[38;5;238m" # Dark Gray Line

SCORES = {"a":1,"b":3,"c":3,"d":2,"e":1,"f":4,"g":2,"h":4,"i":1,"j":8,"k":5,"l":1,"m":3,"n":1,"o":1,"p":3,"q":10,"r":1,"s":1,"t":1,"u":1,"v":4,"w":4,"x":8,"y":4,"z":10}

starts, ends, middle, anchor = args.starts.lower(), args.ends.lower(), args.middle.lower(), args.anchor.lower()
raw_rack = args.rack.lower()

# Parse length filter range
target_min, target_max = None, None
if args.len:
    l_str = args.len.strip()
    try:
        if "-" in l_str and not l_str.startswith("-"):
            parts = l_str.split("-")
            target_min, target_max = int(parts[0]), int(parts[1])
            if target_min > target_max:
                target_min, target_max = target_max, target_min
        elif ".." in l_str:
            parts = l_str.split("..")
            target_min, target_max = int(parts[0]), int(parts[1])
            if target_min > target_max:
                target_min, target_max = target_max, target_min
        elif l_str.endswith("+"):
            target_min = int(l_str[:-1])
        elif l_str.isdigit():
            target_min = target_max = int(l_str)
    except ValueError:
        sys.stderr.write(f"{C_DEF}Notice: Invalid length specification standardizing to default.{C_RESET}\n")

blanks_count = raw_rack.count("?") + raw_rack.count(".")
clean_rack = raw_rack.replace("?", "").replace(".", "")
rack_counts = collections.Counter(clean_rack)

# Board tiles allowance (does not consume rack tiles)
board_allowance = collections.Counter(starts) + collections.Counter(ends) + collections.Counter(middle) + collections.Counter(anchor)

config_dir = os.path.expanduser("~/.config")
dict_json = os.path.join(config_dir, "scrabble_dict.json")
scrabble_txt = os.path.join(config_dir, "scrabble_words.txt")

# 1. Auto-download official Scrabble word list if missing
if not os.path.exists(scrabble_txt):
    try:
        os.makedirs(config_dir, exist_ok=True)
        sys.stderr.write(f"{C_DEF}Downloading official Scrabble word list...{C_RESET}\n")
        url = "https://raw.githubusercontent.com/raun/Scrabble/master/words.txt"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as resp, open(scrabble_txt, "wb") as f:
            f.write(resp.read())
    except Exception as e:
        sys.stderr.write(f"{C_DEF}Notice: Could not download Scrabble word list ({e}).{C_RESET}\n")

# 2. Load Webster Definitions
def_db = {}
if os.path.exists(dict_json):
    try:
        with open(dict_json, "r", encoding="utf-8") as f:
            data = json.load(f)
            if isinstance(data, dict):
                for k, v in data.items():
                    key = k.lower().strip()
                    val = str(v).strip()
                    if key and val:
                        def_db[key] = val
    except Exception:
        pass

# 3. Load Legal Scrabble Words
legal_words = set()
if os.path.exists(scrabble_txt):
    with open(scrabble_txt, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            w = line.strip().lower()
            if w.isalpha() and len(w) >= 2:
                legal_words.add(w)

if not legal_words:
    legal_words = set(def_db.keys())

if not legal_words and os.path.exists("/usr/share/dict/words"):
    with open("/usr/share/dict/words", "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            w = line.strip().lower()
            if w.isalpha() and len(w) >= 2:
                legal_words.add(w)

# 4. Find Valid Matches
valid = []
for w in legal_words:
    if len(w) < 2:
        continue
    if target_min is not None and len(w) < target_min:
        continue
    if target_max is not None and len(w) > target_max:
        continue

    if starts and not w.startswith(starts):
        continue
    if ends and not w.endswith(ends):
        continue
    if anchor and anchor not in w:
        continue
    # Middle condition: letter(s) must appear strictly inside the word body
    if middle and not all(m in w[1:-1] for m in middle):
        continue

    word_counts = collections.Counter(w)
    missing_from_rack = word_counts - rack_counts
    
    taken_from_board = missing_from_rack & board_allowance
    still_missing = missing_from_rack - taken_from_board
    
    needed_blanks = sum(still_missing.values())

    if needed_blanks <= blanks_count:
        missing_letters = sorted(list(still_missing.elements()), key=lambda c: SCORES.get(c, 0), reverse=True)
        base_score = sum(SCORES.get(c, 0) for c in w)
        blank_deduction = sum(SCORES.get(c, 0) for c in missing_letters[:needed_blanks])
        score = base_score - blank_deduction

        rack_tiles_used = sum((word_counts - taken_from_board).values())
        bingo = (rack_tiles_used == 7)
        if bingo:
            score += 50

        defn = def_db.get(w, "")
        valid.append((score, len(w), w, bingo, defn))

def clean_definition(d):
    if not d: return "-"
    d = re.sub(r"^\s*(\d+[\.\s]\s*|\([a-zA-Z\.\s]+\)\s*)+", "", d)
    d = re.sub(r"\[.*?\]", "", d)
    tokens = d.replace("\n", " ").split()
    short = " ".join(tokens[:7])
    if len(tokens) > 7:
        short += "..."
    return short.strip() or "-"

sorted_valid = sorted(valid, key=lambda x: (x[1], x[0]), reverse=True)

if not sorted_valid:
    print(f"{C_DEF}No valid words found.{C_RESET}")
    sys.exit(0)

print(f"{C_BORDER}┌──────┬──────────────────┬───────────────────────────────────────────┐{C_RESET}")
print(f"{C_BORDER}│{C_RESET} {C_SCORE}Pts{C_RESET}  {C_BORDER}│{C_RESET} {C_WORD}Word{C_RESET}             {C_BORDER}│{C_RESET} {C_DIM}Definition                                  {C_BORDER}│{C_RESET}")

prev_len = None
max_scores = {}
for score, length, word, bingo, defn in sorted_valid:
    if length not in max_scores or score > max_scores[length]:
        max_scores[length] = score

for score, length, word, bingo, defn in sorted_valid:
    if prev_len != length:
        label = f"── {length} LETTERS ──"
        padding_left = (71 - len(label)) // 2
        banner = ("─" * padding_left) + label + ("─" * (71 - len(label) - padding_left))
        print(f"{C_BORDER}├{banner}┤{C_RESET}")
        
    prev_len = length

    is_top = (score == max_scores[length])
    pts_color = C_TOP if is_top else C_SCORE
    star = "★ " if is_top else "  "
    pts_cell = f"{star}{score:>2}"
    
    s_len = len(starts) if starts and word.startswith(starts) else 0
    e_len = len(ends) if ends and word.endswith(ends) and len(word) >= s_len + len(ends) else 0
    
    prefix = word[:s_len]
    mid = word[s_len:len(word)-e_len if e_len > 0 else len(word)]
    suffix = word[len(word)-e_len:] if e_len > 0 else ""
    
    word_color = C_TOP if is_top else C_WORD
    
    # Highlight middle/anchor board matches in green inside mid-section
    mid_colored = ""
    board_mid_pool = collections.Counter(middle) + collections.Counter(anchor)
    for char in mid:
        if board_mid_pool[char] > 0:
            mid_colored += f"{C_MATCH}{char}{word_color}"
            board_mid_pool[char] -= 1
        else:
            mid_colored += char

    colored_word = ""
    if prefix: colored_word += f"{C_MATCH}{prefix}{C_RESET}"
    if mid: colored_word += f"{word_color}{mid_colored}{C_RESET}"
    if suffix: colored_word += f"{C_MATCH}{suffix}{C_RESET}"
    
    word_padding = " " * (16 - len(word))
    word_cell = f"{colored_word}{word_padding}"

    def_raw = clean_definition(defn)
    
    if bingo:
        bingo_str = f"{C_BINGO}[BINGO]{C_RESET} "
        max_def_len = 41 - 8
        def_clipped = def_raw[:max_def_len].ljust(max_def_len)
        def_cell = f"{bingo_str}{C_DEF}{def_clipped}{C_RESET}"
    else:
        def_clipped = def_raw[:41].ljust(41)
        def_cell = f"{C_DEF}{def_clipped}{C_RESET}"

    print(f"{C_BORDER}│{C_RESET} {pts_color}{pts_cell}{C_RESET} {C_BORDER}│{C_RESET} {word_cell} {C_BORDER}│{C_RESET} {def_cell} {C_BORDER}│{C_RESET}")

print(f"{C_BORDER}└──────┴──────────────────┴───────────────────────────────────────────┘{C_RESET}")
' "$@"
